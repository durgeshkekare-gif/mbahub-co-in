{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "functions": {
    "api/lead.js": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/universities",
      "destination": "/universities/index.html"
    },
    {
      "source": "/compare",
      "destination": "/compare/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/programs",
      "destination": "/programs/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    }
  ]
}